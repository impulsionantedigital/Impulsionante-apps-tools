# As três variáveis obrigatórias do Awave CRM. Cole no EasyPanel, aba "Environment", e
# preencha. Onde achar cada valor: docs/DEPLOY.md, na seção 1.

SUPABASE_DB_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# E-mail transacional (opcional). Sem estas, o CRM não envia e-mail e diz isso na tela de
# Configurações → Servidor.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURE=
