# As três variáveis obrigatórias do Awave CRM. Cole no EasyPanel, aba "Environment", e
# preencha. Onde achar cada valor: docs/DEPLOY.md, na seção 1.

SUPABASE_DB_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# E-mail transacional (opcional). Sem as cinco primeiras, o CRM não envia e-mail e diz isso na
# tela de Configurações → Servidor.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# SMTP_SECURE é opcional: em branco, é deduzido da porta (true na 465, false nas demais).
# Se preenchido, aceita (sem distinção de maiúsculas): true/1/yes/on como verdadeiro,
# false/0/no/off como falso. Qualquer outro valor é recusado como configuração inválida.
SMTP_SECURE=

# Endereço de venda (checkout) de CADA produto, para o botão que aparece na tela do membro quando
# ele está em degustação ou quando o acesso expirou. Um por produto, com o slug em maiúsculas e o
# hífen trocado por sublinhado. Todos opcionais: sem a variável (ou com ela em branco), a mensagem
# aparece SEM botão — de propósito, para nunca mandar ninguém a um endereço que não existe.
#
# ⚠️ NÃO use o prefixo NEXT_PUBLIC_. Ele é embutido no bundle durante o build da imagem, e o valor
# do painel só entraria se estivesse presente naquele momento. Sem o prefixo, a variável é lida em
# tempo de execução: trocar o link aqui passa a valer com um restart, sem reconstruir a imagem.
#
# Slugs: cic-2025, cic-2024, recolhimento-noturno
CHECKOUT_URL_CIC_2025=
CHECKOUT_URL_CIC_2024=
CHECKOUT_URL_RECOLHIMENTO_NOTURNO=
